# Local plugin cache / init state — regenerated by `terraform init`.
.terraform/

# State (lives in the S3 backend, never committed).
*.tfstate
*.tfstate.*

# Plan output and crash logs.
*.tfplan
crash.log
crash.*.log

# Variable files likely to contain real secrets.
*.tfvars
*.tfvars.json
!example.tfvars

# Override files, used only for local overrides.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

.terraformrc
terraform.rc
