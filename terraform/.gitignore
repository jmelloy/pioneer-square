# Local plugin cache / init state — regenerated by `terraform init`.
.terraform/

# State (lives in the S3 backend, never committed).
*.tfstate
*.tfstate.*

# Plan output and crash logs.
*.tfplan
crash.log
crash.*.log

# Variable files likely to contain real secrets. terraform.tfvars is the
# exception: secrets live in SSM (seeded from .env), so it holds only
# non-secret environment config and is committed. Keep secrets out of it.
*.tfvars
*.tfvars.json
!example.tfvars
!terraform.tfvars

# Override files, used only for local overrides.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

.terraformrc
terraform.rc
