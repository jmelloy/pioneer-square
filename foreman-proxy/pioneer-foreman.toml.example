backend_url = "ws://localhost:8000"
guild_id = "abc123"
log_level = "INFO"

[llm]
# The proxy executes one backend-supplied Foreman API request at a time.
# State, trigger routing, history, and tool execution stay in the backend.
provider = "anthropic" # "anthropic" | "bedrock" | "openai"
model = "claude-sonnet-4-6"
api_key = "" # anthropic/openai key; can also come from ANTHROPIC_API_KEY or OPENAI_API_KEY

# Anthropic OAuth/claude.ai token. Mutually exclusive with api_key; auth_token wins.
# auth_token = ""

# OpenAI-compatible local/remote endpoint, used when provider = "openai".
# For Ollama: base_url = "http://localhost:11434/v1", model = "llama3.1"
# base_url = "http://localhost:11434/v1"

# Bedrock settings, used when provider = "bedrock".
# bedrock_model = "us.anthropic.claude-sonnet-4-6-20250514-v1:0"
# aws_region = "us-east-1"
# aws_profile = ""
