# pioneer-foreman.toml — example configuration for the standalone foreman agent.
#
# Copy this file to pioneer-foreman.toml and fill in the required values.
# Environment variables (PIONEER_BACKEND_URL, PIONEER_GUILD_ID, …) override
# values set here.  CLI flags (--backend-url, --guild-id, …) override env vars.
#
# Required:
#   backend_url  — Backend WebSocket or HTTP base URL.
#   guild_id     — 6-char guild ID shown in the Pioneer Square UI.
#   ANTHROPIC_API_KEY env var (not stored in this file for security).

# Backend URL: supports ws://, wss://, http://, https:// — the foreman
# normalises the scheme automatically.
backend_url = "ws://localhost:8000"

# Guild this foreman instance manages.
guild_id = "abc123"

# Optional: pre-configured worker auth_token from a previous registration.
# When set, the foreman skips the POST /guilds/{guild_id}/workers call on
# startup.  Obtain this token by running the foreman once without it (it
# prints the token at INFO level) or by registering manually via the API.
# Alternatively, set PIONEER_FOREMAN_AUTH_TOKEN in the environment.
#
# auth_token = "your-auth-token-here"

# Claude model for the foreman AI (default: claude-sonnet-4-6).
# Also controlled by the FOREMAN_MODEL environment variable.
#
# [anthropic]
# model = "claude-sonnet-4-6"

# Optional: GitHub personal access token with repo + PR read permissions.
# If absent, the foreman fetches the guild's OAuth token from the backend
# at first use via GET /auth/github/token?guild_id=…
# Also controlled by PIONEER_GITHUB_TOKEN or GITHUB_TOKEN env vars.
#
# github_token = "ghp_..."

# Seconds between background poll cycles (default: 60.0).
# The foreman checks non-terminal tasks at this interval and doubles the
# interval up to poll_interval_max after each quiet cycle.
#
# poll_interval = 60.0
