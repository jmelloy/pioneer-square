# Environment variables for scripts/test_a2a_live.py

# Path to the dnsid-sdk agent config ({"key_path": "..."}).
# Required for sign and verify checks; those tests are skipped when unset.
# Example: ~/.dnsid/nyoyny.pioneer-square.melloy.life/dnsid-sdk.json
DNSID_AGENT_CONFIG=

# Override the dnsid-sdk binary path (default: ~/dnsid-go/bin/dnsid-sdk).
# DNSID_SDK_BIN=

# Override the code-review-agent URL (default: https://agent.meyers.life).
# REVIEWER_AGENT_URL=
