{
  "name": "@pioneer-square/shared-skills",
  "version": "0.1.0",
  "description": "Interactive CLI versions of Pioneer Square shared skills (debug-token, mcp-server-prod, issue-management)",
  "type": "module",
  "license": "UNLICENSED",
  "engines": { "node": ">=20" },
  "bin": {
    "skills": "dist/cli.js",
    "debug-token": "dist/bin/debug-token.js",
    "mcp-server-prod": "dist/bin/mcp-server-prod.js",
    "issue-management": "dist/bin/issue-management.js"
  },
  "files": ["dist", "*.md"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
