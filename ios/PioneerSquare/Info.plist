<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Pioneer Square backend URL. Override per-build configuration via
      Xcode build settings or scheme env. AppConfig.swift reads this key.
    -->
    <key>PIONEER_BACKEND_URL</key>
    <string>https://pioneer-square.example.com</string>

    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>

    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>

    <!--
      Local development against `http://localhost:8000`: uncomment to allow
      plaintext HTTP loads in DEBUG builds. Leave commented for App Store
      builds so ATS keeps protecting production traffic.

    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    -->
</dict>
</plist>
